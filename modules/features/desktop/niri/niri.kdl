prefer-no-csd

@outputConfig@

hotkey-overlay {
  skip-at-startup
}

gestures {
  hot-corners {
    off
  }
}

input {
  focus-follows-mouse max-scroll-amount="0%"

  touchpad {
    tap
    natural-scroll
    accel-speed 0.2
    accel-profile "adaptive"
    scroll-method "two-finger"
    click-method "clickfinger"
    tap-button-map "left-right-middle"
  }
}

cursor {
  xcursor-theme "Bibata-Modern-Classic"
  xcursor-size 16
  hide-when-typing
}

environment {
  XCURSOR_THEME "Bibata-Modern-Classic"
  XCURSOR_SIZE "16"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  QT_QPA_PLATFORM "wayland"
  QT_QPA_PLATFORMTHEME "qt5ct"
  QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
  XDG_SESSION_TYPE "wayland"
  XDG_CURRENT_DESKTOP "niri"
}

layout {
  gaps 8
  center-focused-column "on-overflow"
  default-column-width { proportion 0.5; }

  focus-ring {
    off
  }

  border {
    width 2
    active-color "#cba6f7"
    inactive-color "#1e1e2e"
    urgent-color "#f38ba8"
  }

  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 1.0
  }
}

overview {
  zoom 0.5
  backdrop-color "#1e1e2e"
  workspace-shadow {
    softness 40
    spread 10
    offset x=0 y=10
    color "#00000060"
  }
}

animations {
  workspace-switch {
    spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
  }
  horizontal-view-movement {
    spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
  }
  window-open {
    duration-ms 200
    curve "ease-out-cubic"
  }
  window-close {
    duration-ms 150
    curve "ease-out-cubic"
  }
  window-movement {
    spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
  }
  window-resize {
    spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
  }
}

blur {
  passes 2
  offset 2.5
  noise 0.02
  saturation 1.2
}

window-rule {
  geometry-corner-radius 4
  clip-to-geometry true
  draw-border-with-background false
}

window-rule {
  match app-id=r#"^(com\.mitchellh\.)?ghostty(\..+)?$"#
  match app-id="^foot$"
  match app-id="^footclient$"
  background-effect {
    blur true
    xray false
  }
}

window-rule {
  match app-id="^pcmanfm$"
  match app-id=r#"^org\.pwmt\.zathura.*$"#
  match app-id="^pavucontrol$"
  match app-id="^com.saivert.pwvucontrol$"
  match app-id="^easyeffects$"
  match app-id="^com.gabm.satty$"
  match app-id="^xarchiver$"
  match app-id="^blueman-manager$"
  match app-id=r#"^(?i)learnharness.*$"#
  opacity 0.85
  background-effect {
    blur true
    xray false
  }
}

window-rule {
  match app-id=r#"^dev\.noctalia\.Noctalia.*$"#
  open-floating true
  background-effect {
    blur true
    xray false
  }
}

// System Portals, Dialogs, and Media Players
window-rule {
  match app-id=r#"^org\.freedesktop\.impl\.portal\.desktop.*$"#
  match app-id=r#"^xdg-desktop-portal.*$"#
  match title=r#"^Open File.*$"#
  match title=r#"^Save File.*$"#
  match title=r#"^Save As.*$"#
  match title=r#"^File Upload.*$"#
  match title=r#"^Picture-in-Picture$"#
  match app-id="^pavucontrol$"
  match app-id="^com.saivert.pwvucontrol$"
  match app-id="^easyeffects$"
  match app-id="^com.gabm.satty$"
  match app-id="^xarchiver$"
  match app-id="^blueman-manager$"
  open-floating true
}

layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd|window-switcher)$"
  background-effect {
    blur true
    xray false
  }
}

layer-rule {
  match namespace="^launcher$"
  background-effect {
    blur true
    xray false
  }
}

layer-rule {
  match namespace="^noctalia-backdrop$"
  place-within-backdrop true
}

workspace "one"
workspace "two"
workspace "three"
workspace "four"
workspace "five"
workspace "six"
workspace "seven"
workspace "eight"
workspace "nine"

spawn-at-startup "@systemctl@" "--user" "import-environment" "PATH" "XDG_DATA_DIRS" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "SHELL" "QT_QPA_PLATFORM" "QT_QPA_PLATFORMTHEME" "STARSHIP_CONFIG"
spawn-at-startup "@noctalia@"

binds {
  // === SPACE TREE: VIEWPORT FILL & FLOATING LAYER ===
  Mod+Space              hotkey-overlay-title="Fill Screen (Maximize Column Width)" { maximize-column; }
  Mod+Shift+Space        hotkey-overlay-title="Fullscreen Window"                   { fullscreen-window; }
  Mod+Ctrl+Space         hotkey-overlay-title="Toggle Window Floating"              { toggle-window-floating; }
  Mod+Alt+Space          hotkey-overlay-title="Switch Focus Floating/Tiling"        { switch-focus-between-floating-and-tiling; }

  // === LEFT HAND: APPS & SYSTEM PANELS ===
  // F: Terminal
  Mod+F                  hotkey-overlay-title="Terminal: Foot Client"               { spawn "@footclient@"; }
  Mod+Shift+F            hotkey-overlay-title="Terminal: Tmux Project Sessionizer"  { spawn "@footclient@" "-e" "@tmuxSessionizer@"; }
  Mod+Ctrl+F             hotkey-overlay-title="Terminal: Ghostty Standalone"        { spawn "@ghostty@"; }

  // D: Browser
  Mod+D                  hotkey-overlay-title="Browser: LibreWolf"                  { spawn "@librewolf@"; }
  Mod+Shift+D            hotkey-overlay-title="Browser: Brave Origin"               { spawn "@brave@"; }
  Mod+Ctrl+D             hotkey-overlay-title="Browser: LibreWolf Private"          { spawn "@librewolf@" "--private-window"; }

  // S: Files
  Mod+S                  hotkey-overlay-title="Files: PCManFM File Manager"         { spawn "@pcmanfm@"; }

  // A: Ferdium & Overview
  Mod+A                  hotkey-overlay-title="Chat: Ferdium Messaging Client"      { spawn "@ferdium@"; }
  Mod+Shift+A            hotkey-overlay-title="Overview: Niri Workspace View"       { toggle-overview; }

  // G: Obsidian
  Mod+G                  hotkey-overlay-title="Notes: Obsidian Knowledge Vault"     { spawn "@obsidian@"; }

  // T: Screenshot
  Mod+T                  hotkey-overlay-title="Snip: Area Screenshot to Clipboard"  { spawn "@screenshotArea@"; }
  Mod+Shift+T            hotkey-overlay-title="Snip: Fullscreen Screenshot"         { spawn "@screenshotFull@"; }

  // E & X: Notifications
  Mod+E                  hotkey-overlay-title="Notices: Notification Center Panel"  { spawn "@noctalia@" "msg" "panel-toggle" "notifications"; }
  Mod+Shift+E            hotkey-overlay-title="Notices: Clear Notice History"       { spawn "@noctalia@" "msg" "notification-clear-all"; }
  Mod+X                  hotkey-overlay-title="Notices: Dismiss Active Notice"      { spawn "@noctalia@" "msg" "notification-clear-active"; }

  // V & C: Settings & Control Center
  Mod+V                  hotkey-overlay-title="Settings: Noctalia Settings GUI"     { spawn "@noctalia@" "msg" "settings-toggle"; }
  Mod+Shift+V            hotkey-overlay-title="Clipboard: History Panel"            { spawn "@noctalia@" "msg" "panel-toggle" "clipboard"; }
  Mod+C                  hotkey-overlay-title="Control: Noctalia Control Center"    { spawn "@noctalia@" "msg" "panel-toggle" "control-center"; }
  Mod+Shift+C            hotkey-overlay-title="Audio: Pavucontrol Mixer"            { spawn "@pavucontrol@"; }

  // B & W: Bluetooth & Wi-Fi
  Mod+B                  hotkey-overlay-title="Bluetooth: Noctalia Panel"           { spawn "@noctalia@" "msg" "panel-toggle" "bluetooth"; }
  Mod+Shift+B            hotkey-overlay-title="Security: Bitwarden Desktop"         { spawn "@bitwarden@"; }
  Mod+W                  hotkey-overlay-title="Network: Wi-Fi / Network Panel"      { spawn "@noctalia@" "msg" "panel-toggle" "network"; }
  Mod+Shift+W            hotkey-overlay-title="Wallpaper: Noctalia Panel"           { spawn "@noctalia@" "msg" "panel-toggle" "wallpaper"; }
  Mod+Ctrl+W             hotkey-overlay-title="Bar: Toggle Noctalia Top Bar"        { spawn "@noctalia@" "msg" "bar-toggle"; }

  // R: App Launcher
  Mod+R                  hotkey-overlay-title="Launcher: Noctalia App Runner"       { spawn "@noctalia@" "msg" "panel-toggle" "launcher"; }
  Mod+Shift+R            hotkey-overlay-title="Interactive Hotkey Search"           { spawn "@fuzzelCheatsheet@"; }

  // Esc & Q: Session & Window Actions
  Mod+Escape             hotkey-overlay-title="Session: Noctalia Power Menu"        { spawn "@noctalia@" "msg" "panel-toggle" "session"; }
  Mod+Shift+Escape       hotkey-overlay-title="Session: Lock Screen"                { spawn "@noctalia@" "msg" "session" "lock"; }
  Mod+Ctrl+Escape        hotkey-overlay-title="Monitors: Turn Off Displays"         { power-off-monitors; }
  Mod+Q                  hotkey-overlay-title="Close Focused Window"                { close-window; }

  // === RIGHT HAND: COLUMNS (H / L), WORKSPACES (J / K), AND STACKS (U / I) ===
  // Monitors (Cross-Display: Alt + H / L)
  Mod+Alt+H              hotkey-overlay-title="Focus Monitor Left"                  { focus-monitor-left; }
  Mod+Alt+L              hotkey-overlay-title="Focus Monitor Right"                 { focus-monitor-right; }
  Mod+Alt+Shift+H        hotkey-overlay-title="Move Column to Monitor Left"         { move-column-to-monitor-left; }
  Mod+Alt+Shift+L        hotkey-overlay-title="Move Column to Monitor Right"        { move-column-to-monitor-right; }
  // Columns (Horizontal Ribbon: H / L)
  Mod+H                  hotkey-overlay-title="Focus Column Left"                   { focus-column-left; }
  Mod+L                  hotkey-overlay-title="Focus Column Right"                  { focus-column-right; }
  Mod+Shift+H            hotkey-overlay-title="Move Column Left"                    { move-column-left; }
  Mod+Shift+L            hotkey-overlay-title="Move Column Right"                   { move-column-right; }
  Mod+Ctrl+H             hotkey-overlay-title="Shrink Column Width (-5%)"           { set-column-width "-5%"; }
  Mod+Ctrl+L             hotkey-overlay-title="Expand Column Width (+5%)"           { set-column-width "+5%"; }

  // Workspaces (Vertical Stack: J / K)
  Mod+J                  hotkey-overlay-title="Focus Workspace Down"                { focus-workspace-down; }
  Mod+K                  hotkey-overlay-title="Focus Workspace Up"                  { focus-workspace-up; }
  Mod+Shift+J            hotkey-overlay-title="Move Column to Workspace Down"       { move-column-to-workspace-down; }
  Mod+Shift+K            hotkey-overlay-title="Move Column to Workspace Up"         { move-column-to-workspace-up; }

  // Intra-Column Window Stack & Height Sizing (U / I)
  Mod+U                  hotkey-overlay-title="Focus Window Down in Column"         { focus-window-down; }
  Mod+I                  hotkey-overlay-title="Focus Window Up in Column"           { focus-window-up; }
  Mod+Shift+U            hotkey-overlay-title="Move Window Down in Column"          { move-window-down; }
  Mod+Shift+I            hotkey-overlay-title="Move Window Up in Column"            { move-window-up; }
  Mod+Ctrl+U             hotkey-overlay-title="Shrink Window Height (-5%)"          { set-window-height "-5%"; }
  Mod+Ctrl+I             hotkey-overlay-title="Expand Window Height (+5%)"          { set-window-height "+5%"; }

  // Column Ingestion & Expulsion (M , .)
  Mod+M                  hotkey-overlay-title="Consume Window from Left"            { consume-or-expel-window-left; }
  Mod+Comma              hotkey-overlay-title="Consume Window from Right"           { consume-or-expel-window-right; }
  Mod+Period             hotkey-overlay-title="Expel Window from Column"            { expel-window-from-column; }

  // === ORDERED WORKSPACES (1..9 NAMED + 10 DYNAMIC) ===
  Mod+1                  { focus-workspace "one"; }
  Mod+2                  { focus-workspace "two"; }
  Mod+3                  { focus-workspace "three"; }
  Mod+4                  { focus-workspace "four"; }
  Mod+5                  { focus-workspace "five"; }
  Mod+6                  { focus-workspace "six"; }
  Mod+7                  { focus-workspace "seven"; }
  Mod+8                  { focus-workspace "eight"; }
  Mod+9                  { focus-workspace "nine"; }
  Mod+0                  { focus-workspace 10; }

  Mod+Shift+1            { move-column-to-workspace "one"; }
  Mod+Shift+2            { move-column-to-workspace "two"; }
  Mod+Shift+3            { move-column-to-workspace "three"; }
  Mod+Shift+4            { move-column-to-workspace "four"; }
  Mod+Shift+5            { move-column-to-workspace "five"; }
  Mod+Shift+6            { move-column-to-workspace "six"; }
  Mod+Shift+7            { move-column-to-workspace "seven"; }
  Mod+Shift+8            { move-column-to-workspace "eight"; }
  Mod+Shift+9            { move-column-to-workspace "nine"; }
  Mod+Shift+0            { move-column-to-workspace 10; }

  Mod+WheelScrollDown    cooldown-ms=150 { focus-column-right; }
  Mod+WheelScrollUp      cooldown-ms=150 { focus-column-left; }

  // === HARDWARE MEDIA KEYS ===
  Print                  hotkey-overlay-title="Fullscreen Screenshot"               { spawn "@screenshotFull@"; }
  XF86MonBrightnessUp    { spawn "@brightnessUp@"; }
  XF86MonBrightnessDown  { spawn "@brightnessDown@"; }
  XF86AudioRaiseVolume   { spawn "@wpctl@" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%+"; }
  XF86AudioLowerVolume   { spawn "@wpctl@" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%-"; }
  XF86AudioMute          { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
  XF86AudioMicMute       { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
  XF86AudioPlay          { spawn "@playerctl@" "play-pause"; }
  XF86AudioNext          { spawn "@playerctl@" "next"; }
  XF86AudioPrev          { spawn "@playerctl@" "previous"; }
}
