prefer-no-csd

@outputConfig@

hotkey-overlay {
  skip-at-startup
}

gestures {
  hot-corners {
    off
  }
}

input {
  focus-follows-mouse max-scroll-amount="0%"

  touchpad {
    tap
    natural-scroll
    accel-speed 0.2
    accel-profile "adaptive"
    scroll-method "two-finger"
    click-method "clickfinger"
    tap-button-map "left-right-middle"
  }
}

cursor {
  xcursor-theme "Bibata-Modern-Classic"
  xcursor-size 16
  hide-when-typing
}

environment {
  XCURSOR_THEME "Bibata-Modern-Classic"
  XCURSOR_SIZE "16"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  QT_QPA_PLATFORM "wayland"
  QT_QPA_PLATFORMTHEME "qt5ct"
  QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
  XDG_SESSION_TYPE "wayland"
  XDG_CURRENT_DESKTOP "niri"
}

layout {
  gaps 8
  center-focused-column "on-overflow"
  default-column-width { proportion 0.5; }

  focus-ring {
    off
  }

  border {
    width 2
    active-color "#cba6f7"
    inactive-color "#1e1e2e"
    urgent-color "#f38ba8"
  }

  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 1.0
  }
}

overview {
  zoom 0.5
  backdrop-color "#1e1e2e"
  workspace-shadow {
    softness 40
    spread 10
    offset x=0 y=10
    color "#00000060"
  }
}

animations {
  workspace-switch {
    spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
  }
  horizontal-view-movement {
    spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
  }
  window-open {
    duration-ms 200
    curve "ease-out-cubic"
  }
  window-close {
    duration-ms 150
    curve "ease-out-cubic"
  }
  window-movement {
    spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
  }
  window-resize {
    spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
  }
}

blur {
  passes 2
  offset 2.5
  noise 0.02
  saturation 1.2
}

window-rule {
  geometry-corner-radius 4
  clip-to-geometry true
  draw-border-with-background false
}

window-rule {
  match app-id=r#"^(com\.mitchellh\.)?ghostty(\..+)?$"#
  background-effect {
    blur true
    xray false
  }
}

window-rule {
  match app-id="^pcmanfm$"
  match app-id=r#"^org\.pwmt\.zathura.*$"#
  match app-id="^pavucontrol$"
  match app-id="^com.saivert.pwvucontrol$"
  match app-id="^easyeffects$"
  match app-id="^com.gabm.satty$"
  match app-id="^xarchiver$"
  match app-id="^blueman-manager$"
  opacity 0.85
  background-effect {
    blur true
    xray false
  }
}

window-rule {
  match app-id=r#"^dev\.noctalia\.Noctalia.*$"#
  open-floating true
  background-effect {
    blur true
    xray false
  }
}

window-rule {
  match app-id=r#"^.*\.scratchpad.*$"#
  match app-id=r#"^.*\.popup.*$"#
  match app-id=r#"^.*\.floating.*$"#
  match title=r#"^.*\(Scratchpad\)$"#
  open-floating true
  default-column-width { proportion 0.65; }
}

window-rule {
  match title=r#"^Sign in.*"#
  match title=r#"^Sign In.*"#
  match title=r#"^Authentication.*"#
  match title=r#"^Confirm.*"#
  match title=r#"^Extension: \(Bitwarden.*\)"#
  match title=r#"^Bitwarden.*"#
  match title=r#"^Sidebery.*"#
  match title=r#"^Open File.*$"#
  match title=r#"^Save File.*$"#
  match title=r#"^Save As.*$"#
  match title=r#"^File Upload.*$"#
  match app-id=r#"^org\.freedesktop\.impl\.portal\.desktop.*$"#
  match app-id=r#"^xdg-desktop-portal.*$"#
  match title=r#"^Picture-in-Picture$"#
  match app-id="^pavucontrol$"
  match app-id="^com.saivert.pwvucontrol$"
  match app-id="^easyeffects$"
  match app-id="^com.gabm.satty$"
  match app-id="^xarchiver$"
  match app-id="^blueman-manager$"
  open-floating true
}

layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd|window-switcher)$"
  background-effect {
    blur true
    xray false
  }
}

layer-rule {
  match namespace="^launcher$"
  background-effect {
    blur true
    xray false
  }
}

layer-rule {
  match namespace="^noctalia-backdrop$"
  place-within-backdrop true
}

workspace "one"
workspace "two"
workspace "three"
workspace "four"
workspace "five"
workspace "six"
workspace "seven"
workspace "eight"
workspace "nine"

spawn-at-startup "@systemctl@" "--user" "import-environment" "PATH" "XDG_DATA_DIRS" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "SHELL" "QT_QPA_PLATFORM" "QT_QPA_PLATFORMTHEME"
spawn-at-startup "@noctalia@"

binds {
  Mod+Space              hotkey-overlay-title="Switch Focus Floating/Tiling"        { switch-focus-between-floating-and-tiling; }
  Mod+Shift+Space        hotkey-overlay-title="Toggle Window Floating"              { toggle-window-floating; }
  Mod+Return             hotkey-overlay-title="Maximize Column Width"               { maximize-column; }
  Mod+Shift+Return       hotkey-overlay-title="Fullscreen Window"                   { fullscreen-window; }
  Mod+Slash              hotkey-overlay-title="Interactive Hotkey Search"           { spawn "@fuzzelCheatsheet@"; }

  // === LEFT HAND: CORE ENGINES (A S D F G) ===
  Mod+A                  hotkey-overlay-title="Launcher: Noctalia App Runner"       { spawn "@noctalia@" "msg" "panel-toggle" "launcher"; }
  Mod+Shift+A            hotkey-overlay-title="Overview: Niri Workspace View"       { toggle-overview; }
  Mod+Ctrl+A             hotkey-overlay-title="Control Center: Noctalia Panel"      { spawn "@noctalia@" "msg" "panel-toggle" "control-center"; }

  Mod+S                  hotkey-overlay-title="Search: LibreWolf (Run/Raise)"       { spawn "@runOrRaise@" "librewolf" "@librewolf@"; }
  Mod+Shift+S            hotkey-overlay-title="Search: Toggle Floating LibreWolf"   { spawn "@toggleScratchpad@" "librewolf" "@librewolf@" "--class=librewolf.popup"; }
  Mod+Ctrl+S             hotkey-overlay-title="Search: Force New Tiled LibreWolf"   { spawn "@librewolf@"; }
  Mod+Alt+S              hotkey-overlay-title="Search: LibreWolf Private Window"    { spawn "@librewolf@" "--private-window"; }

  Mod+D                  hotkey-overlay-title="Dev: Ghostty (Run/Raise)"            { spawn "@runOrRaise@" "ghostty" "@ghostty@"; }
  Mod+Shift+D            hotkey-overlay-title="Dev: Toggle Floating Terminal"       { spawn "@toggleScratchpad@" "ghostty.scratchpad" "@ghostty@" "--class=ghostty.scratchpad"; }
  Mod+Ctrl+D             hotkey-overlay-title="Dev: Force New Tiled Ghostty"        { spawn "@ghostty@"; }
  Mod+Alt+D              hotkey-overlay-title="Dev: Fuzzy Project Tmux Sessionizer" { spawn "@ghostty@" "--class=ghostty.scratchpad" "-e" "@tmuxSessionizer@"; }

  Mod+F                  hotkey-overlay-title="Files: PCManFM (Run/Raise)"          { spawn "@runOrRaise@" "pcmanfm" "@pcmanfm@"; }
  Mod+Shift+F            hotkey-overlay-title="Files: Toggle Floating PCManFM"      { spawn "@toggleScratchpad@" "pcmanfm" "@pcmanfm@"; }
  Mod+Ctrl+F             hotkey-overlay-title="Files: Force New Tiled PCManFM"      { spawn "@pcmanfm@"; }

  Mod+G                  hotkey-overlay-title="Glance: Notification Center"         { spawn "@noctalia@" "msg" "panel-toggle" "notifications"; }
  Mod+Shift+G            hotkey-overlay-title="Glance: Dismiss Active Notice"       { spawn "@noctalia@" "msg" "notification-clear-active"; }
  Mod+Ctrl+G             hotkey-overlay-title="Bar: Toggle Noctalia Top Bar"        { spawn "@noctalia@" "msg" "bar-toggle"; }

  // === LEFT HAND: NEIGHBORS (Z X C V B & Q W E R T) ===
  Mod+Z                  hotkey-overlay-title="Notes: ZenNotes (Run/Raise)"         { spawn "@runOrRaise@" "zennotes-desktop" "@zennotes@"; }
  Mod+Shift+Z            hotkey-overlay-title="Notes: Toggle Floating ZenNotes"     { spawn "@toggleScratchpad@" "zennotes-desktop" "@zennotes@"; }
  Mod+Ctrl+Z             hotkey-overlay-title="Notes: Force New Tiled ZenNotes"     { spawn "@zennotes@"; }

  Mod+X                  hotkey-overlay-title="Explore: nnn Helix Dashboard"        { spawn "@runOrRaise@" "ghostty.nnn" "@ghostty@" "--class=ghostty.nnn" "-e" "@nnn@" "-e" "-C"; }
  Mod+Shift+X            hotkey-overlay-title="Explore: Toggle Floating nnn"        { spawn "@toggleScratchpad@" "ghostty.scratchpad" "@ghostty@" "--class=ghostty.scratchpad" "-e" "@nnn@" "-e" "-C"; }
  Mod+Ctrl+X             hotkey-overlay-title="Explore: Force New Tiled nnn"        { spawn "@ghostty@" "-e" "@nnn@" "-e" "-C"; }

  Mod+C                  hotkey-overlay-title="Universal Copy (Ctrl+Insert)"        { spawn "@wtype@" "-M" "ctrl" "-k" "Insert" "-m" "ctrl"; }
  Mod+Shift+C            hotkey-overlay-title="Universal Cut (Shift+Delete)"        { spawn "@wtype@" "-M" "shift" "-k" "Delete" "-m" "shift"; }
  Mod+V                  hotkey-overlay-title="Universal Paste (Shift+Insert)"      { spawn "@wtype@" "-M" "shift" "-k" "Insert" "-m" "shift"; }
  Mod+Shift+V            hotkey-overlay-title="Clipboard: Noctalia History Panel"   { spawn "@noctalia@" "msg" "panel-toggle" "clipboard"; }

  Mod+B                  hotkey-overlay-title="Bluetooth: Noctalia Panel"           { spawn "@noctalia@" "msg" "panel-toggle" "bluetooth"; }
  Mod+Shift+B            hotkey-overlay-title="Security: Bitwarden Desktop"         { spawn "@runOrRaise@" "bitwarden" "bitwarden"; }

  Mod+Q                  hotkey-overlay-title="Close Focused Window"                { close-window; }
  Mod+W                  hotkey-overlay-title="Wallpaper: Noctalia Panel"           { spawn "@noctalia@" "msg" "panel-toggle" "wallpaper"; }
  Mod+E                  hotkey-overlay-title="Audio: Pavucontrol Mixer"            { spawn "@pavucontrol@"; }
  Mod+Shift+E            hotkey-overlay-title="Audio: EasyEffects DSP Effects"      { spawn "@easyeffects@"; }
  Mod+R                  hotkey-overlay-title="Snip: Area Screenshot to Clipboard"  { spawn "@screenshotArea@"; }
  Mod+Shift+R            hotkey-overlay-title="Snip: Fullscreen to Clipboard"       { spawn "@screenshotFull@"; }
  Mod+T                  hotkey-overlay-title="Settings: Noctalia Settings GUI"     { spawn "@noctalia@" "msg" "settings-toggle"; }

  // === RIGHT HAND: NAVIGATION, GEOMETRY & STACKING ===
  Mod+H                  hotkey-overlay-title="Navigate: Focus Column Left"         { focus-column-left; }
  Mod+L                  hotkey-overlay-title="Navigate: Focus Column Right"        { focus-column-right; }
  Mod+J                  hotkey-overlay-title="Workspace: Focus Workspace Down"     { focus-workspace-down; }
  Mod+K                  hotkey-overlay-title="Workspace: Focus Workspace Up"       { focus-workspace-up; }

  Mod+Shift+H            hotkey-overlay-title="Move: Move Column Left"              { move-column-left; }
  Mod+Shift+L            hotkey-overlay-title="Move: Move Column Right"             { move-column-right; }
  Mod+Shift+J            hotkey-overlay-title="Workspace: Move Column Down"         { move-column-to-workspace-down; }
  Mod+Shift+K            hotkey-overlay-title="Workspace: Move Column Up"           { move-column-to-workspace-up; }

  Mod+N                  hotkey-overlay-title="Stack: Focus Window Down"            { focus-window-down; }
  Mod+Shift+N            hotkey-overlay-title="Stack: Move Window Down"             { move-window-down; }
  Mod+M                  hotkey-overlay-title="Stack: Focus Window Up"              { focus-window-up; }
  Mod+Shift+M            hotkey-overlay-title="Stack: Move Window Up"               { move-window-up; }

  Mod+U                  hotkey-overlay-title="Stack: Consume/Expel Window Left"    { consume-or-expel-window-left; }
  Mod+I                  hotkey-overlay-title="Stack: Consume/Expel Window Right"   { consume-or-expel-window-right; }

  Mod+Y                  hotkey-overlay-title="Width: Shrink Column Width (-5%)"    { set-column-width "-5%"; }
  Mod+O                  hotkey-overlay-title="Width: Expand Column Width (+5%)"    { set-column-width "+5%"; }
  Mod+Shift+Y            hotkey-overlay-title="Height: Shrink Window Height (-5%)"  { set-window-height "-5%"; }
  Mod+Shift+O            hotkey-overlay-title="Height: Expand Window Height (+5%)"  { set-window-height "+5%"; }

  Mod+P                  hotkey-overlay-title="Power: Noctalia Session Menu"        { spawn "@noctalia@" "msg" "panel-toggle" "session"; }
  Mod+Shift+P            hotkey-overlay-title="Lock: Lock Screen"                   { spawn "@noctalia@" "msg" "session" "lock"; }
  Mod+Ctrl+P             hotkey-overlay-title="Monitors: Turn Off Displays"         { power-off-monitors; }

  Mod+Comma              hotkey-overlay-title="Monitor: Focus Monitor Left"         { focus-monitor-left; }
  Mod+Shift+Comma        hotkey-overlay-title="Monitor: Move Column to Monitor L"   { move-column-to-monitor-left; }
  Mod+Period             hotkey-overlay-title="Monitor: Focus Monitor Right"        { focus-monitor-right; }
  Mod+Shift+Period       hotkey-overlay-title="Monitor: Move Column to Monitor R"   { move-column-to-monitor-right; }

  // === WORKSPACES (1..9 NAMED + 10 DYNAMIC) ===
  Mod+1                  { focus-workspace "one"; }
  Mod+2                  { focus-workspace "two"; }
  Mod+3                  { focus-workspace "three"; }
  Mod+4                  { focus-workspace "four"; }
  Mod+5                  { focus-workspace "five"; }
  Mod+6                  { focus-workspace "six"; }
  Mod+7                  { focus-workspace "seven"; }
  Mod+8                  { focus-workspace "eight"; }
  Mod+9                  { focus-workspace "nine"; }
  Mod+0                  { focus-workspace 10; }

  Mod+Shift+1            { move-column-to-workspace "one"; }
  Mod+Shift+2            { move-column-to-workspace "two"; }
  Mod+Shift+3            { move-column-to-workspace "three"; }
  Mod+Shift+4            { move-column-to-workspace "four"; }
  Mod+Shift+5            { move-column-to-workspace "five"; }
  Mod+Shift+6            { move-column-to-workspace "six"; }
  Mod+Shift+7            { move-column-to-workspace "seven"; }
  Mod+Shift+8            { move-column-to-workspace "eight"; }
  Mod+Shift+9            { move-column-to-workspace "nine"; }
  Mod+Shift+0            { move-column-to-workspace 10; }

  Mod+WheelScrollDown    cooldown-ms=150 { focus-column-right; }
  Mod+WheelScrollUp      cooldown-ms=150 { focus-column-left; }

  // === HARDWARE MEDIA KEYS ===
  Print                  hotkey-overlay-title="Fullscreen Screenshot"               { spawn "@screenshotFull@"; }
  XF86MonBrightnessUp    { spawn "@brightnessUp@"; }
  XF86MonBrightnessDown  { spawn "@brightnessDown@"; }
  XF86AudioRaiseVolume   { spawn "@wpctl@" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%+"; }
  XF86AudioLowerVolume   { spawn "@wpctl@" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%-"; }
  XF86AudioMute          { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
  XF86AudioMicMute       { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
  XF86AudioPlay          { spawn "@playerctl@" "play-pause"; }
  XF86AudioNext          { spawn "@playerctl@" "next"; }
  XF86AudioPrev          { spawn "@playerctl@" "previous"; }
}
