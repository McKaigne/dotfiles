output "DP-1" {
  mode "1920x1080@240.000"
  scale 1.0
}

hotkey-overlay {
  skip-at-startup
}

input {
  focus-follows-mouse max-scroll-amount="0%"

  touchpad {
    tap
    natural-scroll
    accel-speed 0.2
    accel-profile "adaptive"
    scroll-method "two-finger"
    click-method "clickfinger"
    tap-button-map "left-right-middle"
  }
}

cursor {
  xcursor-theme "Bibata-Modern-Classic"
  xcursor-size 16
  hide-when-typing
}

environment {
  XCURSOR_THEME "Bibata-Modern-Classic"
  XCURSOR_SIZE "16"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  QT_QPA_PLATFORM "wayland"
  QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
  XDG_SESSION_TYPE "wayland"
  XDG_CURRENT_DESKTOP "niri"
}

layout {
  gaps 10
  center-focused-column "on-overflow"
  default-column-width { proportion 0.5; }

  focus-ring {
    width 2
    active-color   "#2aa198"
    inactive-color "#073642"
    urgent-color   "#dc322f"
  }
  border {
    width 1
    active-color   "#2aa198"
    inactive-color "#073642"
    urgent-color   "#dc322f"
  }
  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 1.0
  }
}

animations {
  workspace-switch {
    spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
  }
  horizontal-view-movement {
    spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
  }
  window-open {
    duration-ms 200
    curve "ease-out-cubic"
  }
  window-close {
    duration-ms 150
    curve "ease-out-cubic"
  }
  window-movement {
    spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
  }
  window-resize {
    spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
  }
}

blur {
  passes 3
  offset 3.0
  noise 0.02
  saturation 1.2
}

include optional=true "~/.config/niri/noctalia.kdl"
include optional=true "~/.config/niri/custom.kdl"

// Base window geometry
window-rule {
  geometry-corner-radius 12
  clip-to-geometry true
  draw-border-with-background false
}

// Terminal & editor blur
window-rule {
  match app-id="^ghostty$"
  match app-id="^com.mitchellh.ghostty$"
  background-effect {
    blur true
    xray false
  }
}

// Noctalia popups & settings
window-rule {
  match app-id=r#"^dev\.noctalia\.Noctalia.*$"#
  open-floating true
  background-effect {
    blur true
    xray false
  }
}

// Dialogs, pickers, and portals (Ly-sec ruleset)
window-rule {
  match app-id=r#"^org\.freedesktop\.impl\.portal\.desktop.*$"#
  match app-id=r#"^xdg-desktop-portal.*$"#
  match app-id="^pavucontrol$"
  match app-id="^com.saivert.pwvucontrol$"
  match app-id="^easyeffects$"
  match app-id="^com.gabm.satty$"
  match app-id="^org.gnome.FileRoller$"
  match app-id="^blueman-manager$"
  match title=r#"^Picture-in-Picture$"#
  match title=r#"^Open File.*$"#
  match title=r#"^Save File.*$"#
  match title=r#"^Save As.*$"#
  open-floating true
}

// Compositor layers
layer-rule {
  match namespace="^wallpaper$"
  place-within-backdrop true
}

layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    blur true
    xray false
  }
}

layer-rule {
  match namespace="^launcher$"
  background-effect {
    blur true
    xray false
  }
}

debug {
  honor-xdg-activation-with-invalid-serial
}

workspace "w0"
workspace "w1"
workspace "w2"
workspace "w3"
workspace "w4"
workspace "w5"
workspace "w6"
workspace "w7"
workspace "w8"
workspace "w9"

spawn-at-startup "@noctalia@"
spawn-at-startup "@xwaylandSatellite@"
spawn-at-startup "@systemctl@" "--user" "import-environment" "PATH" "XDG_DATA_DIRS" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
spawn-at-startup "@systemctl@" "--user" "start" "graphical-session.target"

binds {
  // Primary Applications
  Mod+Return             hotkey-overlay-title="Terminal: Ghostty"                   { spawn "@ghostty@"; }
  Mod+A                  hotkey-overlay-title="Workspace Sessionizer: Zellij"       { spawn "@zellijFocus@"; }
  Mod+W                  hotkey-overlay-title="Web Browser: Brave Origin"           { spawn "@brave@"; }
  Mod+O                  hotkey-overlay-title="Notes: Obsidian"                     { spawn "@obsidian@"; }
  Mod+S                  hotkey-overlay-title="Area Screenshot (Drag)"              { spawn "@screenshotArea@"; }
  Mod+E                  hotkey-overlay-title="File Manager: Nautilus"              { spawn "@nautilus@"; }
  Mod+D                  hotkey-overlay-title="Application Launcher"                { spawn "@noctalia@" "msg" "panel-toggle" "launcher"; }

  // Noctalia Panels
  Mod+V                  hotkey-overlay-title="Clipboard History"                   { spawn "@noctalia@" "msg" "panel-toggle" "clipboard"; }
  Mod+N                  hotkey-overlay-title="Notification Center"                 { spawn "@noctalia@" "msg" "panel-toggle" "notifications"; }
  Mod+C                  hotkey-overlay-title="Control Center"                      { spawn "@noctalia@" "msg" "panel-toggle" "control-center"; }
  Mod+B                  hotkey-overlay-title="Bluetooth Panel"                     { spawn "@noctalia@" "msg" "panel-toggle" "bluetooth"; }
  Mod+I                  hotkey-overlay-title="Internet / Wi-Fi Panel"              { spawn "@noctalia@" "msg" "panel-toggle" "network"; }
  Mod+P                  hotkey-overlay-title="Power & Session Menu"                { spawn "@noctalia@" "msg" "panel-toggle" "session"; }
  Mod+Shift+W            hotkey-overlay-title="Wallpaper Selector"                  { spawn "@noctalia@" "msg" "panel-toggle" "wallpaper"; }
  Mod+Comma              hotkey-overlay-title="Noctalia Settings"                   { spawn "@noctalia@" "msg" "settings-toggle"; }
  Mod+Shift+B            hotkey-overlay-title="Toggle Bar Visibility"               { spawn "@noctalia@" "msg" "bar-toggle"; }
  Mod+Escape             hotkey-overlay-title="Lock Screen"                         { spawn "@noctalia@" "msg" "session" "lock"; }
  Mod+Slash              hotkey-overlay-title="Hotkey Cheat Sheet"                  { show-hotkey-overlay; }

  // Window Layout & Cycling
  Mod+Q                  hotkey-overlay-title="Close Focused Window"                { close-window; }
  Mod+F                  hotkey-overlay-title="Maximize Column"                     { maximize-column; }
  Mod+Shift+F            hotkey-overlay-title="Fullscreen Window"                   { fullscreen-window; }
  Mod+Shift+Space        hotkey-overlay-title="Toggle Window Floating"              { toggle-window-floating; }
  Mod+R                  hotkey-overlay-title="Cycle Column Width Presets"          { switch-preset-column-width; }
  Mod+Shift+C            hotkey-overlay-title="Center Column on Screen"             { center-column; }

  // Audio Utilities
  Mod+M                  hotkey-overlay-title="Audio Effects: EasyEffects"          { spawn "@easyeffects@"; }
  Mod+Shift+M            hotkey-overlay-title="Volume Mixer: Pavucontrol"           { spawn "@pavucontrol@"; }

  // Navigation (Vim + Arrows)
  Mod+H                  { focus-column-left; }
  Mod+L                  { focus-column-right; }
  Mod+J                  { focus-workspace-down; }
  Mod+K                  { focus-workspace-up; }

  Mod+Shift+H            { move-column-left; }
  Mod+Shift+L            { move-column-right; }
  Mod+Shift+J            { move-column-to-workspace-down; }
  Mod+Shift+K            { move-column-to-workspace-up; }

  Mod+Left               { focus-column-left; }
  Mod+Right              { focus-column-right; }
  Mod+Down               { focus-workspace-down; }
  Mod+Up                 { focus-workspace-up; }
  Mod+Shift+Left         { move-column-left; }
  Mod+Shift+Right        { move-column-right; }
  Mod+Shift+Down         { move-column-to-workspace-down; }
  Mod+Shift+Up           { move-column-to-workspace-up; }

  // Mouse Wheel Navigation
  Mod+WheelScrollDown    cooldown-ms=150 { focus-column-right; }
  Mod+WheelScrollUp      cooldown-ms=150 { focus-column-left; }

  // Workspaces
  Mod+1                  { focus-workspace "w1"; }
  Mod+2                  { focus-workspace "w2"; }
  Mod+3                  { focus-workspace "w3"; }
  Mod+4                  { focus-workspace "w4"; }
  Mod+5                  { focus-workspace "w5"; }
  Mod+6                  { focus-workspace "w6"; }
  Mod+7                  { focus-workspace "w7"; }
  Mod+8                  { focus-workspace "w8"; }
  Mod+9                  { focus-workspace "w9"; }
  Mod+0                  { focus-workspace "w0"; }

  Mod+Shift+1            { move-column-to-workspace "w1"; }
  Mod+Shift+2            { move-column-to-workspace "w2"; }
  Mod+Shift+3            { move-column-to-workspace "w3"; }
  Mod+Shift+4            { move-column-to-workspace "w4"; }
  Mod+Shift+5            { move-column-to-workspace "w5"; }
  Mod+Shift+6            { move-column-to-workspace "w6"; }
  Mod+Shift+7            { move-column-to-workspace "w7"; }
  Mod+Shift+8            { move-column-to-workspace "w8"; }
  Mod+Shift+9            { move-column-to-workspace "w9"; }
  Mod+Shift+0            { move-column-to-workspace "w0"; }

  // Width adjustments
  Mod+Minus              { set-column-width "-5%"; }
  Mod+Equal              { set-column-width "+5%"; }
  Mod+Shift+Minus        { set-window-height "-5%"; }
  Mod+Shift+Equal        { set-window-height "+5%"; }
  Mod+Backspace          { spawn "@noctalia@" "msg" "notification-clear-active"; }

  // Hardware Keys
  Print                  hotkey-overlay-title="Fullscreen Screenshot"               { spawn "@screenshotFull@"; }
  XF86MonBrightnessUp    { spawn "@brightnessUp@"; }
  XF86MonBrightnessDown  { spawn "@brightnessDown@"; }
  XF86AudioRaiseVolume   { spawn "@wpctl@" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%+"; }
  XF86AudioLowerVolume   { spawn "@wpctl@" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%-"; }
  XF86AudioMute          { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
  XF86AudioMicMute       { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
  XF86AudioPlay          { spawn "@playerctl@" "play-pause"; }
  XF86AudioNext          { spawn "@playerctl@" "next"; }
  XF86AudioPrev          { spawn "@playerctl@" "previous"; }

  Mod+Ctrl+Escape        hotkey-overlay-title="Turn Off Monitors"                   { power-off-monitors; }
}
