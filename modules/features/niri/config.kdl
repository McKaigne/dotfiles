prefer-no-csd

hotkey-overlay {
  skip-at-startup
}

input {
  warp-mouse-to-focus
  focus-follows-mouse
  touchpad {
    tap
    natural-scroll
  }
}

cursor {
  xcursor-theme "Bibata-Modern-Classic"
  xcursor-size 16
  hide-when-typing
}

environment {
  XCURSOR_THEME "Bibata-Modern-Classic"
  XCURSOR_SIZE "16"
}

layout {
  gaps 8
  focus-ring {
    width 2
  }
  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 1.0
  }
}

window-rule {
  geometry-corner-radius 12
  clip-to-geometry true
}

workspace "w0"
workspace "w1"
workspace "w2"
workspace "w3"
workspace "w4"
workspace "w5"
workspace "w6"
workspace "w7"
workspace "w8"
workspace "w9"
workspace "scratch"

spawn-at-startup "@noctaliaShell@"
spawn-at-startup "@xwaylandSatellite@"
spawn-at-startup "@systemctl@" "--user" "import-environment" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"

binds {
  // ==========================================
  // Core Navigation & Window Controls
  // ==========================================
  Mod+Space          { spawn "@noctaliaShell@" "ipc" "call" "launcher" "toggle"; }
  Mod+Escape         { spawn "@noctaliaShell@" "ipc" "call" "sessionMenu" "toggle"; }
  Mod+Ctrl+L         { spawn "@loginctl@" "lock-session"; }
  Mod+W              { close-window; }
  Mod+Q              { close-window; }
  Ctrl+Alt+Delete    { spawn-sh "for id in $(@niri@ msg -j windows | @jq@ -r '.[].id'); do @niri@ msg action close-window --id $id; done"; }
  Mod+T              { toggle-window-floating; }
  Mod+O              { toggle-window-floating; }
  Mod+P              { reset-window-height; }

  // Fullscreen & Maximize
  Mod+F              { fullscreen-window; }
  Mod+Alt+F          { maximize-column; }
  Mod+Ctrl+F         { expand-column-to-available-width; }

  // Directional Focus (Arrows + HJKL redundancy)
  Mod+Left           { focus-column-left; }
  Mod+Right          { focus-column-right; }
  Mod+H              { focus-column-left; }
  Mod+L              { focus-column-right; }

  // Workspaces (J and K strictly preserved for vertical switching)
  Mod+Down           { focus-workspace-down; }
  Mod+Up             { focus-workspace-up; }
  Mod+J              { focus-workspace-down; }
  Mod+K              { focus-workspace-up; }

  Mod+Shift+Left     { move-column-left; }
  Mod+Shift+Right    { move-column-right; }
  Mod+Shift+H        { move-column-left; }
  Mod+Shift+L        { move-column-right; }

  Mod+Shift+Down     { move-column-to-workspace-down; }
  Mod+Shift+Up       { move-column-to-workspace-up; }
  Mod+Shift+J        { move-column-to-workspace-down; }
  Mod+Shift+K        { move-column-to-workspace-up; }

  Mod+Tab            { focus-workspace-down; }
  Mod+Shift+Tab      { focus-workspace-up; }
  Mod+Ctrl+Tab       { focus-workspace-previous; }

  // Workspaces 1-4 (+ extensions)
  Mod+1              { focus-workspace "w1"; }
  Mod+2              { focus-workspace "w2"; }
  Mod+3              { focus-workspace "w3"; }
  Mod+4              { focus-workspace "w4"; }
  Mod+5              { focus-workspace "w5"; }
  Mod+6              { focus-workspace "w6"; }
  Mod+7              { focus-workspace "w7"; }
  Mod+8              { focus-workspace "w8"; }
  Mod+9              { focus-workspace "w9"; }
  Mod+0              { focus-workspace "w0"; }

  Mod+Shift+1        { move-column-to-workspace "w1"; }
  Mod+Shift+2        { move-column-to-workspace "w2"; }
  Mod+Shift+3        { move-column-to-workspace "w3"; }
  Mod+Shift+4        { move-column-to-workspace "w4"; }
  Mod+Shift+5        { move-column-to-workspace "w5"; }
  Mod+Shift+6        { move-column-to-workspace "w6"; }
  Mod+Shift+7        { move-column-to-workspace "w7"; }
  Mod+Shift+8        { move-column-to-workspace "w8"; }
  Mod+Shift+9        { move-column-to-workspace "w9"; }
  Mod+Shift+0        { move-column-to-workspace "w0"; }

  Mod+Shift+Alt+1    { move-column-to-workspace "w1"; }
  Mod+Shift+Alt+2    { move-column-to-workspace "w2"; }
  Mod+Shift+Alt+3    { move-column-to-workspace "w3"; }
  Mod+Shift+Alt+4    { move-column-to-workspace "w4"; }

  // Scratchpad
  Mod+S              { focus-workspace "scratch"; }
  Mod+Grave          { focus-workspace "scratch"; }
  Mod+Alt+S          { move-column-to-workspace "scratch"; }
  Mod+Shift+Grave    { move-column-to-workspace "scratch"; }

  // Monitor Navigation (Arrows + HJKL)
  Mod+Shift+Alt+Left  { move-workspace-to-monitor-left; }
  Mod+Shift+Alt+Right { move-workspace-to-monitor-right; }
  Mod+Shift+Alt+Up    { move-workspace-to-monitor-up; }
  Mod+Shift+Alt+Down  { move-workspace-to-monitor-down; }
  Mod+Shift+Alt+H     { move-workspace-to-monitor-left; }
  Mod+Shift+Alt+L     { move-workspace-to-monitor-right; }
  Mod+Shift+Alt+K     { move-workspace-to-monitor-up; }
  Mod+Shift+Alt+J     { move-workspace-to-monitor-down; }

  // Resizing
  Mod+Minus          { set-column-width "-5%"; }
  Mod+Equal          { set-column-width "+5%"; }
  Mod+Shift+Minus    { set-window-height "-5%"; }
  Mod+Shift+Equal    { set-window-height "+5%"; }

  Mod+Alt+Minus      { set-column-width "-2%"; }
  Mod+Alt+Equal      { set-column-width "+2%"; }
  Mod+Ctrl+Minus     { set-column-width "-10%"; }
  Mod+Ctrl+Equal     { set-column-width "+10%"; }

  Mod+Alt+Home       { reset-window-height; }
  Mod+Home           { switch-preset-column-width; }

  // Window Grouping (Arrows + HJKL)
  Mod+G              { consume-or-expel-window-left; }
  Mod+Alt+G          { expel-window-from-column; }
  Mod+Alt+Tab        { focus-window-down; }
  Mod+Alt+Shift+Tab  { focus-window-up; }
  Mod+Alt+1          { focus-window-top; }
  Mod+Alt+2          { focus-window-down; }
  Mod+Alt+Left       { consume-or-expel-window-left; }
  Mod+Alt+Right      { consume-or-expel-window-right; }
  Mod+Alt+H          { consume-or-expel-window-left; }
  Mod+Alt+L          { consume-or-expel-window-right; }
  Mod+Ctrl+Left      { focus-column-left; }
  Mod+Ctrl+Right     { focus-column-right; }
  Mod+Ctrl+H         { focus-column-left; }
  Mod+Ctrl+L         { focus-column-right; }

  // Zoom & Monitor Scaling
  Mod+Ctrl+Z         { toggle-overview; }
  Mod+Ctrl+Alt+Z     { toggle-overview; }
  Mod+Slash          { switch-preset-column-width; }
  Mod+Alt+Slash      { switch-preset-column-width-back; }

  // Cycling
  Alt+Tab            { focus-column-right-or-first; }
  Alt+Shift+Tab      { focus-column-left-or-last; }
  Ctrl+Alt+Tab       { focus-monitor-next; }
  Ctrl+Alt+Shift+Tab { focus-monitor-previous; }

  // Mouse Gestures
  Mod+WheelScrollDown { focus-workspace-down; }
  Mod+WheelScrollUp   { focus-workspace-up; }

  // Applications
  Mod+Return         { spawn "@ghostty@"; }
  Mod+E              { spawn "@thunar@"; }
  Mod+C              { spawn "@emacsclient@" "-c" "-a" "emacs"; }

  // ==========================================
  // Notifications & Style
  // ==========================================
  Mod+Comma                { spawn "@noctaliaShell@" "ipc" "call" "notifications" "dismiss"; }
  Mod+Shift+Comma          { spawn "@noctaliaShell@" "ipc" "call" "notifications" "dismissAll"; }
  Mod+Ctrl+Comma           { spawn "@noctaliaShell@" "ipc" "call" "notifications" "toggleSilence"; }
  Mod+Alt+Comma            { spawn "@noctaliaShell@" "ipc" "call" "notifications" "invoke"; }
  Mod+Shift+Alt+Comma      { spawn "@noctaliaShell@" "ipc" "call" "controlCenter" "toggle"; }

  Mod+Ctrl+Shift+Space     { spawn "@noctaliaShell@" "ipc" "call" "launcher" "toggle"; }
  Mod+Ctrl+Space           { spawn "@noctaliaShell@" "ipc" "call" "wallpaper" "random"; }
  Mod+Backspace            { toggle-window-floating; }
  Mod+Ctrl+Backspace       { reset-window-height; switch-preset-column-width; }
  Mod+Shift+Backspace      { toggle-window-gaps; }

  // ==========================================
  // Toggles & System Controls
  // ==========================================
  Mod+Ctrl+I               { spawn-sh "pkill -USR1 swayidle || true"; }
  Mod+Ctrl+N               { spawn-sh "pkill wlsunset || @wlsunset@ -l 14.5995 -L 120.9842"; }
  Mod+Ctrl+Delete          { spawn-sh "@niri@ msg output eDP-1 toggle"; }
  Mod+Shift+Space          { spawn "@noctaliaShell@" "ipc" "call" "bar" "toggle"; }

  // Audio / Media
  Shift+XF86AudioMute      { spawn-sh "@wpctl@ set-default $(@wpctl@ status | grep -A 5 Sinks | grep -v '*' | grep -o '[0-9]\\+' | head -n 1)"; }
  Shift+XF86AudioPlay      { spawn-sh "@playerctl@ --all-players next"; }

  Mod+Ctrl+A               { spawn "@noctaliaShell@" "ipc" "call" "controlCenter" "toggle"; }
  Mod+Ctrl+B               { spawn "@noctaliaShell@" "ipc" "call" "controlCenter" "toggle"; }
  Mod+Ctrl+W               { spawn "@noctaliaShell@" "ipc" "call" "controlCenter" "toggle"; }
  Mod+Ctrl+D               { spawn "@noctaliaShell@" "ipc" "call" "controlCenter" "toggle"; }
  Mod+Ctrl+P               { spawn "@noctaliaShell@" "ipc" "call" "sessionMenu" "toggle"; }
  Mod+Ctrl+Alt+D           { spawn "@noctaliaShell@" "ipc" "call" "controlCenter" "toggle"; }
  Mod+Ctrl+S               { spawn "@localsend@"; }
  Mod+Ctrl+T               { spawn "@ghostty@" "-e" "@btop@"; }
  Mod+Ctrl+C               { spawn-sh "@grim@ -g \"$(@slurp@)\" - | @wlCopy@"; }
  Mod+Ctrl+O               { spawn "@noctaliaShell@" "ipc" "call" "launcher" "toggle"; }
  Mod+Ctrl+H               { spawn "@ghostty@" "-e" "@btop@"; }
  Mod+Ctrl+Q               { spawn "@qalculate@"; }
  Mod+Ctrl+E               { spawn "@noctaliaShell@" "ipc" "call" "launcher" "emoji"; }

  // Standard Hardware Function Keys
  Mod+Shift+S              { spawn-sh "@grim@ -g \"$(@slurp@)\" - | @wlCopy@"; }
  Print                    { spawn-sh "@grim@ - | @wlCopy@"; }
  XF86MonBrightnessUp      { spawn-sh "@brightnessctl@ set +5%"; }
  XF86MonBrightnessDown    { spawn-sh "curr=$(@brightnessctl@ get); max=$(@brightnessctl@ max); new=$((curr - max * 5 / 100)); [ ${new} -lt $((max * 5 / 100)) ] && @brightnessctl@ set 5% || @brightnessctl@ set 5%-"; }
  XF86AudioRaiseVolume     { spawn "@wpctl@" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%+"; }
  XF86AudioLowerVolume     { spawn "@wpctl@" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%-"; }
  XF86AudioMute            { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
  XF86AudioMicMute         { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
  XF86AudioPlay            { spawn "@playerctl@" "play-pause"; }
  XF86AudioNext            { spawn "@playerctl@" "next"; }
  XF86AudioPrev            { spawn "@playerctl@" "previous"; }
}

include optional=true "~/.config/niri/noctalia.kdl"