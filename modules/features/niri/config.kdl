prefer-no-csd

hotkey-overlay {
  skip-at-startup
}

input {
  warp-mouse-to-focus
  focus-follows-mouse
  touchpad {
    tap
    natural-scroll
  }
}

cursor {
  xcursor-theme "Bibata-Modern-Classic"
  xcursor-size 16
  hide-when-typing
}

environment {
  XCURSOR_THEME "Bibata-Modern-Classic"
  XCURSOR_SIZE "16"
}

layout {
  gaps 8
  focus-ring {
    width 2
  }
  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 1.0
  }
}

window-rule {
  geometry-corner-radius 12
  clip-to-geometry true
}

workspace "w0"
workspace "w1"
workspace "w2"
workspace "w3"
workspace "w4"
workspace "w5"
workspace "w6"
workspace "w7"
workspace "w8"
workspace "w9"
workspace "scratch"

spawn-at-startup "@noctaliaShell@"
spawn-at-startup "@xwaylandSatellite@"
spawn-at-startup "@systemctl@" "--user" "import-environment" "PATH" "XDG_DATA_DIRS" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"

binds {
  // ==========================================
  // Core Applications & Window Operations
  // ==========================================
  Mod+W              { spawn "@helium@"; }
  Mod+Q              { close-window; }
  Mod+Return         { spawn "@ghostty@"; }
  Mod+E              { spawn "@thunar@"; }
  Mod+C              { spawn "@emacsclient@" "-c" "-a" "emacs"; }
  Mod+Z              { spawn "@zed@"; }

  // Launchers & Menus (Adjacent: Mod alone / Mod+Ctrl)
  Mod+Space          { spawn "@noctaliaShell@" "ipc" "call" "launcher" "toggle"; }
  Mod+Ctrl+Space     { spawn "@fuzzel@"; }
  Mod+Escape         { spawn "@noctaliaShell@" "ipc" "call" "sessionMenu" "toggle"; }
  Mod+Ctrl+L         { spawn "@loginctl@" "lock-session"; }

  // Layout & Sizing (Adjacent: Mod / Mod+Ctrl / Mod+Shift)
  Mod+F              { fullscreen-window; }
  Mod+Ctrl+F         { maximize-column; }
  Mod+Shift+F        { expand-column-to-available-width; }
  Mod+T              { toggle-window-floating; }
  Mod+P              { reset-window-height; }
  Mod+Home           { switch-preset-column-width; }
  Mod+Ctrl+Home      { reset-window-height; }

  // Directional Focus (Single Mod: Middle finger)
  Mod+Left           { focus-column-left; }
  Mod+Right          { focus-column-right; }
  Mod+H              { focus-column-left; }
  Mod+L              { focus-column-right; }
  Mod+Down           { focus-workspace-down; }
  Mod+Up             { focus-workspace-up; }
  Mod+J              { focus-workspace-down; }
  Mod+K              { focus-workspace-up; }

  // Move Column / Workspace (Adjacent: Mod+Shift [Middle+Index])
  Mod+Shift+Left     { move-column-left; }
  Mod+Shift+Right    { move-column-right; }
  Mod+Shift+H        { move-column-left; }
  Mod+Shift+L        { move-column-right; }
  Mod+Shift+Down     { move-column-to-workspace-down; }
  Mod+Shift+Up       { move-column-to-workspace-up; }
  Mod+Shift+J        { move-column-to-workspace-down; }
  Mod+Shift+K        { move-column-to-workspace-up; }

  // Quick Cycling (Adjacent: Mod+Shift / Mod+Ctrl)
  Mod+Tab            { focus-workspace-down; }
  Mod+Shift+Tab      { focus-workspace-up; }
  Mod+Ctrl+Tab       { focus-workspace-previous; }

  // Workspaces 0-9 (Single Mod / Mod+Shift)
  Mod+1              { focus-workspace "w1"; }
  Mod+2              { focus-workspace "w2"; }
  Mod+3              { focus-workspace "w3"; }
  Mod+4              { focus-workspace "w4"; }
  Mod+5              { focus-workspace "w5"; }
  Mod+6              { focus-workspace "w6"; }
  Mod+7              { focus-workspace "w7"; }
  Mod+8              { focus-workspace "w8"; }
  Mod+9              { focus-workspace "w9"; }
  Mod+0              { focus-workspace "w0"; }

  Mod+Shift+1        { move-column-to-workspace "w1"; }
  Mod+Shift+2        { move-column-to-workspace "w2"; }
  Mod+Shift+3        { move-column-to-workspace "w3"; }
  Mod+Shift+4        { move-column-to-workspace "w4"; }
  Mod+Shift+5        { move-column-to-workspace "w5"; }
  Mod+Shift+6        { move-column-to-workspace "w6"; }
  Mod+Shift+7        { move-column-to-workspace "w7"; }
  Mod+Shift+8        { move-column-to-workspace "w8"; }
  Mod+Shift+9        { move-column-to-workspace "w9"; }
  Mod+Shift+0        { move-column-to-workspace "w0"; }

  // Scratchpad (Adjacent: Mod / Mod+Ctrl / Mod+Shift)
  Mod+S              { focus-workspace "scratch"; }
  Mod+Grave          { focus-workspace "scratch"; }
  Mod+Ctrl+S         { move-column-to-workspace "scratch"; }
  Mod+Shift+Grave    { move-column-to-workspace "scratch"; }

  // Monitor Navigation (Adjacent: Mod+Ctrl+Alt [Middle+Ring+Pinky])
  Mod+Ctrl+Alt+Left  { move-workspace-to-monitor-left; }
  Mod+Ctrl+Alt+Right { move-workspace-to-monitor-right; }
  Mod+Ctrl+Alt+Up    { move-workspace-to-monitor-up; }
  Mod+Ctrl+Alt+Down  { move-workspace-to-monitor-down; }
  Mod+Ctrl+Alt+H     { move-workspace-to-monitor-left; }
  Mod+Ctrl+Alt+L     { move-workspace-to-monitor-right; }
  Mod+Ctrl+Alt+K     { move-workspace-to-monitor-up; }
  Mod+Ctrl+Alt+J     { move-workspace-to-monitor-down; }

  // Resizing (Adjacent: Mod / Mod+Shift / Mod+Ctrl / Mod+Ctrl+Alt)
  Mod+Minus          { set-column-width "-5%"; }
  Mod+Equal          { set-column-width "+5%"; }
  Mod+Shift+Minus    { set-window-height "-5%"; }
  Mod+Shift+Equal    { set-window-height "+5%"; }
  Mod+Ctrl+Minus     { set-column-width "-2%"; }
  Mod+Ctrl+Equal     { set-column-width "+2%"; }
  Mod+Ctrl+Alt+Minus { set-column-width "-10%"; }
  Mod+Ctrl+Alt+Equal { set-column-width "+10%"; }

  // Window Grouping (Adjacent: Mod / Mod+Ctrl)
  Mod+G              { consume-or-expel-window-left; }
  Mod+Ctrl+G         { expel-window-from-column; }
  Mod+Ctrl+Left      { consume-or-expel-window-left; }
  Mod+Ctrl+Right     { consume-or-expel-window-right; }
  Mod+Ctrl+H         { consume-or-expel-window-left; }
  Mod+Ctrl+J         { focus-window-down; }
  Mod+Ctrl+K         { focus-window-up; }

  // Overview & Preset Navigation (Adjacent: Mod+Ctrl)
  Mod+Ctrl+Z         { toggle-overview; }
  Mod+Slash          { switch-preset-column-width; }
  Mod+Ctrl+Slash     { switch-preset-column-width-back; }

  // Mouse Gestures
  Mod+WheelScrollDown { focus-workspace-down; }
  Mod+WheelScrollUp   { focus-workspace-up; }

  // Notifications (Adjacent: Mod / Mod+Shift / Mod+Ctrl)
  Mod+Comma          { spawn "@noctaliaShell@" "ipc" "call" "notifications" "dismiss"; }
  Mod+Shift+Comma    { spawn "@noctaliaShell@" "ipc" "call" "notifications" "dismissAll"; }
  Mod+Ctrl+Comma     { spawn "@noctaliaShell@" "ipc" "call" "notifications" "toggleSilence"; }
  Mod+N              { spawn "@noctaliaShell@" "ipc" "call" "controlCenter" "toggle"; }
  Mod+I              { spawn "@noctaliaShell@" "ipc" "call" "controlCenter" "toggle"; }
  Mod+Period         { spawn "@noctaliaShell@" "ipc" "call" "launcher" "emoji"; }

  // System Toggles (Adjacent: Mod+Ctrl / Mod+Shift)
  Mod+Ctrl+I         { spawn-sh "pkill -USR1 swayidle || true"; }
  Mod+Ctrl+N         { spawn-sh "pkill wlsunset || @wlsunset@ -l 14.5995 -L 120.9842"; }
  Mod+Ctrl+Delete    { spawn-sh "@niri@ msg output eDP-1 toggle"; }
  Mod+Shift+Space    { spawn "@noctaliaShell@" "ipc" "call" "bar" "toggle"; }

  // Hardware & Media Controls
  Mod+Shift+S        { spawn-sh "@grim@ -g \"$(@slurp@)\" - | @wlCopy@"; }
  Print              { spawn-sh "@grim@ - | @wlCopy@"; }
  XF86MonBrightnessUp   { spawn-sh "@brightnessctl@ set +5%"; }
  XF86MonBrightnessDown { spawn-sh "curr=$(@brightnessctl@ get); max=$(@brightnessctl@ max); new=$((curr - max * 5 / 100)); [ ${new} -lt $((max * 5 / 100)) ] && @brightnessctl@ set 5% || @brightnessctl@ set 5%-"; }
  XF86AudioRaiseVolume  { spawn "@wpctl@" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%+"; }
  XF86AudioLowerVolume  { spawn "@wpctl@" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%-"; }
  XF86AudioMute         { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
  XF86AudioMicMute      { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
  XF86AudioPlay         { spawn "@playerctl@" "play-pause"; }
  XF86AudioNext         { spawn "@playerctl@" "next"; }
  XF86AudioPrev         { spawn "@playerctl@" "previous"; }
}

include optional=true "~/.config/niri/noctalia.kdl"