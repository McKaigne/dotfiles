prefer-no-csd

hotkey-overlay {
  skip-at-startup
}

input {
  focus-follows-mouse max-scroll-amount="0%"

  touchpad {
    tap
    natural-scroll
    accel-speed 0.2
    accel-profile "adaptive"
    scroll-method "two-finger"
    click-method "clickfinger"
    tap-button-map "left-right-middle"
  }
}

cursor {
  xcursor-theme "Bibata-Modern-Classic"
  xcursor-size 16
  hide-when-typing
}

environment {
  XCURSOR_THEME "Bibata-Modern-Classic"
  XCURSOR_SIZE "16"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  QT_QPA_PLATFORM "wayland"
  QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
  XDG_SESSION_TYPE "wayland"
  XDG_CURRENT_DESKTOP "niri"
}

layout {
  gaps 8
  focus-ring {
    width 2
    active-color   "#6c7086"
    inactive-color "#313244"
    urgent-color   "#f38ba8"
  }
  border {
    width 1
    active-color   "#6c7086"
    inactive-color "#313244"
    urgent-color   "#f38ba8"
  }
  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 1.0
  }
}

include optional=true "@userHome@/.config/niri/noctalia.kdl"
include optional=true "@userHome@/.config/niri/custom.kdl"

window-rule {
  geometry-corner-radius 12
  clip-to-geometry true
  draw-border-with-background false
}

layer-rule {
  match namespace="^wallpaper$"
  place-within-backdrop true
}

debug {
  honor-xdg-activation-with-invalid-serial
}

workspace "w0"
workspace "w1"
workspace "w2"
workspace "w3"
workspace "w4"
workspace "w5"
workspace "w6"
workspace "w7"
workspace "w8"
workspace "w9"

spawn-at-startup "@noctalia@"
spawn-at-startup "@xwaylandSatellite@"
spawn-at-startup "@systemctl@" "--user" "import-environment" "PATH" "XDG_DATA_DIRS" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
spawn-at-startup "@systemctl@" "--user" "start" "graphical-session.target"

binds {
  Mod+A                  hotkey-overlay-title="Zellij Session Picker"               { spawn "@zellijAttach@"; }
  Mod+S                  hotkey-overlay-title="Music: Pear Desktop"                 { spawn "@pearDesktop@"; }
  Mod+D                  hotkey-overlay-title="Primary Editor: Helix"               { spawn "@helixFocus@"; }
  Mod+F                  hotkey-overlay-title="Maximize Column"                     { maximize-column; }
  Mod+G                  hotkey-overlay-title="Git Client: Lazygit"                 { spawn "@ghostty@" "-e" "@lazygit@"; }

  Mod+Q                  hotkey-overlay-title="Close Focused Window"                { close-window; }
  Mod+W                  hotkey-overlay-title="Browser: Qutebrowser (Vim)"          { spawn "@qutebrowser@"; }
  Mod+Shift+W            hotkey-overlay-title="Browser: Helium (Fallback/DRM)"      { spawn "@helium@"; }
  Mod+E                  hotkey-overlay-title="File Manager: Nautilus"              { spawn "@nautilus@"; }
  Mod+X                  hotkey-overlay-title="Fuzzel Fast Launcher"                { spawn "@fuzzel@"; }
  Mod+C                  hotkey-overlay-title="Center Column on Screen"             { center-column; }
  Mod+V                  hotkey-overlay-title="Clipboard History"                   { spawn "@noctalia@" "msg" "panel-toggle" "clipboard"; }
  Mod+P                  hotkey-overlay-title="Power & Session Menu"                { spawn "@noctalia@" "msg" "panel-toggle" "session"; }

  Mod+M                  hotkey-overlay-title="Audio Effects: EasyEffects"          { spawn "@easyeffects@"; }
  Mod+Shift+M            hotkey-overlay-title="Volume Mixer: Pavucontrol"           { spawn "@pavucontrol@"; }

  Mod+T                  hotkey-overlay-title="Terminal: Zellij (Focus/Spawn)"      { spawn "@zellijFocus@"; }
  Mod+Return             hotkey-overlay-title="Terminal: Ghostty (Plain)"           { spawn "@ghostty@"; }
  Mod+Space              hotkey-overlay-title="Application Launcher"                { spawn "@noctalia@" "msg" "panel-toggle" "launcher"; }
  Mod+Shift+Space        hotkey-overlay-title="Toggle Window Floating"              { toggle-window-floating; }
  Mod+Shift+F            hotkey-overlay-title="Fullscreen Window"                   { fullscreen-window; }

  Mod+N                  hotkey-overlay-title="Control Center"                      { spawn "@noctalia@" "msg" "panel-toggle" "control-center"; }
  Mod+Comma              hotkey-overlay-title="Noctalia Settings"                   { spawn "@noctalia@" "msg" "settings-toggle"; }
  Mod+Escape             hotkey-overlay-title="Lock Screen"                         { spawn "@noctalia@" "msg" "session" "lock"; }
  Mod+B                  hotkey-overlay-title="Toggle Bar"                          { spawn "@noctalia@" "msg" "bar-toggle"; }
  Mod+Backspace          hotkey-overlay-title="Dismiss Notification"                { spawn "@noctalia@" "msg" "notification-clear-active"; }
  Mod+Slash              hotkey-overlay-title="Hotkey Cheat Sheet"                  { show-hotkey-overlay; }

  Mod+H                  hotkey-overlay-title="Focus Column Left"                   { focus-column-left; }
  Mod+L                  hotkey-overlay-title="Focus Column Right"                  { focus-column-right; }
  Mod+J                  hotkey-overlay-title="Focus Workspace Down"                { focus-workspace-down; }
  Mod+K                  hotkey-overlay-title="Focus Workspace Up"                  { focus-workspace-up; }

  Mod+Shift+H            hotkey-overlay-title="Move Column Left"                    { move-column-left; }
  Mod+Shift+L            hotkey-overlay-title="Move Column Right"                   { move-column-right; }
  Mod+Shift+J            hotkey-overlay-title="Move Column to WS Down"              { move-column-to-workspace-down; }
  Mod+Shift+K            hotkey-overlay-title="Move Column to WS Up"                { move-column-to-workspace-up; }

  Mod+Left               { focus-column-left; }
  Mod+Right              { focus-column-right; }
  Mod+Down               { focus-workspace-down; }
  Mod+Up                 { focus-workspace-up; }
  Mod+Shift+Left         { move-column-left; }
  Mod+Shift+Right        { move-column-right; }
  Mod+Shift+Down         { move-column-to-workspace-down; }
  Mod+Shift+Up           { move-column-to-workspace-up; }

  Mod+1                  { focus-workspace "w1"; }
  Mod+2                  { focus-workspace "w2"; }
  Mod+3                  { focus-workspace "w3"; }
  Mod+4                  { focus-workspace "w4"; }
  Mod+5                  { focus-workspace "w5"; }
  Mod+6                  { focus-workspace "w6"; }
  Mod+7                  { focus-workspace "w7"; }
  Mod+8                  { focus-workspace "w8"; }
  Mod+9                  { focus-workspace "w9"; }
  Mod+0                  { focus-workspace "w0"; }

  Mod+Shift+1            { move-column-to-workspace "w1"; }
  Mod+Shift+2            { move-column-to-workspace "w2"; }
  Mod+Shift+3            { move-column-to-workspace "w3"; }
  Mod+Shift+4            { move-column-to-workspace "w4"; }
  Mod+Shift+5            { move-column-to-workspace "w5"; }
  Mod+Shift+6            { move-column-to-workspace "w6"; }
  Mod+Shift+7            { move-column-to-workspace "w7"; }
  Mod+Shift+8            { move-column-to-workspace "w8"; }
  Mod+Shift+9            { move-column-to-workspace "w9"; }
  Mod+Shift+0            { move-column-to-workspace "w0"; }

  Mod+Minus              hotkey-overlay-title="Column Width -5%"                    { set-column-width "-5%"; }
  Mod+Equal              hotkey-overlay-title="Column Width +5%"                    { set-column-width "+5%"; }
  Mod+Shift+Minus        hotkey-overlay-title="Window Height -5%"                   { set-window-height "-5%"; }
  Mod+Shift+Equal        hotkey-overlay-title="Window Height +5%"                   { set-window-height "+5%"; }

  Mod+Shift+S            hotkey-overlay-title="Area Screenshot"                     { spawn "@screenshotArea@"; }
  Print                  hotkey-overlay-title="Fullscreen Screenshot"               { spawn "@screenshotFull@"; }

  XF86MonBrightnessUp    { spawn "@brightnessUp@"; }
  XF86MonBrightnessDown  { spawn "@brightnessDown@"; }
  XF86AudioRaiseVolume   { spawn "@wpctl@" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%+"; }
  XF86AudioLowerVolume   { spawn "@wpctl@" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%-"; }
  XF86AudioMute          { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
  XF86AudioMicMute       { spawn "@wpctl@" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
  XF86AudioPlay          { spawn "@playerctl@" "play-pause"; }
  XF86AudioNext          { spawn "@playerctl@" "next"; }
  XF86AudioPrev          { spawn "@playerctl@" "previous"; }

  Mod+Ctrl+Escape        hotkey-overlay-title="Turn Off Monitors"                   { power-off-monitors; }
}
