{
  "appLauncher": {
    "autoPasteClipboard": false,
    "clipboardWrapText": true,
    "customLaunchPrefix": "systemd-run --user --scope --collect --",
    "customLaunchPrefixEnabled": true,
    "density": "default",
    "enableClipPreview": true,
    "enableClipboardChips": true,
    "enableClipboardHistory": true,
    "enableClipboardSmartIcons": true,
    "enableSessionSearch": true,
    "enableSettingsSearch": true,
    "enableWindowsSearch": true,
    "iconMode": "tabler",
    "ignoreMouseInput": false,
    "overviewLayer": false,
    "pinnedApps": [],
    "position": "center",
    "showCategories": true,
    "showIconBackground": false,
    "sortByMostUsed": true,
    "terminalCommand": "ghostty -e",
    "viewMode": "list"
  },
  "bar": {
    "backgroundOpacity": 0.93,
    "barType": "floating",
    "density": "default",
    "displayMode": "always_visible",
    "enableExclusionZoneInset": true,
    "frameRadius": 12,
    "marginHorizontal": 4,
    "marginVertical": 4,
    "position": "bottom",
    "rightClickAction": "controlCenter",
    "widgetSpacing": 6
  },
  "colorSchemes": {
    "darkMode": true,
    "generationMethod": "tonal-spot",
    "predefinedScheme": "Catppuccin",
    "schedulingMode": "off",
    "syncGsettings": true,
    "useWallpaperColors": false
  },
  "hooks": {
    "colorGeneration": "/home/@user@/.config/noctalia/hooks/theme-sync.sh",
    "enabled": true,
    "startup": "/home/@user@/.config/noctalia/hooks/theme-sync.sh"
  },
  "notifications": {
    "backgroundOpacity": 1,
    "clearDismissed": true,
    "criticalUrgencyDuration": 15,
    "enabled": true,
    "location": "top_right",
    "normalUrgencyDuration": 8
  },
  "templates": {
    "activeTemplates": [
      { "enabled": true, "id": "cava" },
      { "enabled": true, "id": "starship" },
      { "enabled": true, "id": "niri" },
      { "enabled": true, "id": "qt" },
      { "enabled": true, "id": "gtk" },
      { "enabled": true, "id": "helix" },
      { "enabled": true, "id": "zathura" },
      { "enabled": true, "id": "ghostty" },
      { "enabled": true, "id": "btop" }
    ],
    "enableUserTheming": true
  }
}
