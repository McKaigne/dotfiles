# Generated by Noctalia: Tide segments follow the active theme. They use the
# accent container color, a dark accent tint, so they stand out from the
# translucent terminal background; the clock uses its matching text color.
for var in (set --universal --names | string match --regex '^tide_.*_bg_color')
    set --universal $var '{{colors.primary_container.default.hex}}'
end
set --universal tide_time_color '{{colors.on_primary_container.default.hex}}'
