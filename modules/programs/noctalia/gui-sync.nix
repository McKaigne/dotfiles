{
  flake.modules.homeManager.noctalia =
    { pkgs, ... }:
    let
      syncScript = pkgs.writeShellScript "noctalia-sync-to-nixos" ''
        set -euo pipefail
        state_file="$HOME/.local/state/noctalia/settings.toml"
        repo_target="/etc/nixos/modules/programs/noctalia/config/99-gui.nix"

        [ -f "$state_file" ] || exit 0
        [ -w "/etc/nixos/modules/programs/noctalia/config" ] || exit 0

        tmp="$(mktemp)"
        cat << 'HEADER' > "$tmp"
# Auto-generated by noctalia-sync-repo.service from ~/.local/state/noctalia/settings.toml
{
  flake.modules.homeManager.noctalia =
    { pkgs, ... }:
    {
      xdg.configFile."noctalia/99-gui.toml".source =
        (pkgs.formats.toml { }).generate "99-gui.toml"
HEADER

        ${pkgs.remarshal}/bin/remarshal -if toml -of json < "$state_file" | ${pkgs.nix}/bin/nix-instantiate --eval --expr 'builtins.fromJSON (builtins.readFile "/dev/stdin")' >> "$tmp"

        cat << 'FOOTER' >> "$tmp"
          ;
    };
}
FOOTER

        if [ ! -f "$repo_target" ] || ! cmp -s "$tmp" "$repo_target"; then
          cp "$tmp" "$repo_target"
          chmod 0664 "$repo_target"
        fi
        rm -f "$tmp"
      '';
    in
    {
      systemd.user.services.noctalia-sync-repo = {
        Unit.Description = "Sync live Noctalia GUI settings into /etc/nixos";
        Service = {
          Type = "oneshot";
          ExecStart = "${syncScript}";
        };
      };

      systemd.user.paths.noctalia-sync-repo = {
        Unit.Description = "Watch Noctalia settings.toml for GUI changes";
        Path.PathModified = "%h/.local/state/noctalia/settings.toml";
        Install.WantedBy = [ "default.target" ];
      };
    };
}
