{
  # `nsync`: promote Noctalia Settings-GUI changes into the repo, then deploy.
  # The GUI writes ~/.local/state/noctalia/settings.toml, which overrides the
  # declarative config. nsync merges it into config/99-gui.nix, switches, and
  # clears the state file so the repo is the only source again. Hyde only.
  flake.modules.homeManager.noctalia-gui-sync = {pkgs, ...}: {
    home.packages = [
      (pkgs.writeShellApplication {
        name = "nsync";
        runtimeInputs = [pkgs.remarshal pkgs.jq pkgs.coreutils pkgs.gnused];
        text = ''
          state="$HOME/.local/state/noctalia/settings.toml"
          deployed="$HOME/.config/noctalia/99-gui.toml"
          target=/etc/nixos/modules/programs/noctalia/config/99-gui.nix

          if [ ! -s "$state" ]; then
            echo "No Noctalia GUI changes to sync."
            exit 0
          fi

          # Earlier syncs live in the deployed 99-gui.toml; new GUI changes win.
          merged="$(
            {
              if [ -f "$deployed" ]; then remarshal -if toml -of json < "$deployed"; else echo '{}'; fi
              remarshal -if toml -of json < "$state"
            } | jq -s '(.[0] * .[1]) | del(.config_version)'
          )"
          # Escape quotes and interpolation for the Nix indented string below.
          json="$(printf '%s\n' "$merged" | sed -e "s/'''/''''/g" -e "s/\''${/'''\''${/g")"

          cat > "$target" <<EOF
          # Generated by nsync from the Noctalia settings GUI. Edit freely, or
          # delete this file to drop all GUI overrides.
          {
            flake.modules.homeManager."noctalia" = {pkgs, ...}: {
              xdg.configFile."noctalia/99-gui.toml".source = (pkgs.formats.toml {}).generate "99-gui.toml" (builtins.fromJSON '''
          $json
              ''');
            };
          }
          EOF

          git -C /etc/nixos --no-pager diff --stat -- "$target" || true
          ndeploy switch
          mv "$state" "$state.synced"
          echo "Synced. Run 'nr castor' to apply it on castor, and commit when happy."
        '';
      })
    ];
  };
}
