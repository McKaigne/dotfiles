let
  style = import ../../../appearance/_style.nix;
in {
  flake.modules.homeManager.noctalia = {pkgs, ...}: let
    reloadZathura = pkgs.writeShellScript "reload-zathura" ''
      for dest in $(${pkgs.dbus}/bin/dbus-send --session --dest=org.freedesktop.DBus --type=method_call --print-reply /org/freedesktop/DBus org.freedesktop.DBus.ListNames 2>/dev/null | ${pkgs.gnugrep}/bin/grep -o 'org\.pwmt\.zathura\.PID-[0-9]*' || true); do
        ${pkgs.dbus}/bin/dbus-send --session --dest="$dest" --type=method_call /org/pwmt/zathura org.pwmt.zathura.ExecuteCommand string:source >/dev/null 2>&1 || true
      done
    '';

    # Open foot windows only read colors at startup; push OSC palette updates
    # to every terminal the user owns, pywal-style. New windows use the foot template.
    pushTerminalColors = pkgs.writeShellScript "push-terminal-colors" ''
      seq="$(${pkgs.bash}/bin/bash "''${XDG_CACHE_HOME:-$HOME/.cache}/noctalia/terminal-colors.sh")"
      for pts in /dev/pts/[0-9]*; do
        if [ -O "$pts" ] && [ -w "$pts" ]; then
          ${pkgs.coreutils}/bin/timeout 1 ${pkgs.bash}/bin/bash -c 'printf "%s" "$1" > "$2"' _ "$seq" "$pts" 2>/dev/null &
        fi
      done
      wait
    '';

    glassLast = pkgs.writeShellApplication {
      name = "gtk-glass-last";
      runtimeInputs = [pkgs.gnugrep pkgs.coreutils];
      text = builtins.readFile ../../../appearance/_gtk-glass-last.sh;
    };

    # Running GTK3 apps only re-read gtk.css when the theme setting changes,
    # so flip it away and back. The file picker is drawn by
    # xdg-desktop-portal-gtk, which ignores that; restart it instead. Both a
    # couple of seconds later, so Noctalia's own gtk3 template has written
    # noctalia.css by then.
    gtk3Reload = pkgs.writeShellScript "gtk3-reload" ''
      key=/org/gnome/desktop/interface/gtk-theme
      theme="$(${pkgs.dconf}/bin/dconf read "$key")"
      if [ -n "$theme" ]; then
        ${pkgs.dconf}/bin/dconf write "$key" "'Adwaita'"
        ${pkgs.coreutils}/bin/sleep 0.2
        ${pkgs.dconf}/bin/dconf write "$key" "$theme"
      fi
      ${pkgs.systemd}/bin/systemctl --user try-restart xdg-desktop-portal-gtk.service || true
    '';

    gtk3Changed = pkgs.writeShellScript "gtk3-theme-changed" ''
      ${glassLast}/bin/gtk-glass-last
      ${pkgs.systemd}/bin/systemd-run --user --quiet --on-active=2 ${gtk3Reload} || true
    '';

    # GTK glass: redefine Noctalia's surface backgrounds with alpha. Only
    # background colors change, so text, icons and selections stay solid.
    gtkGlassCss = extra: (let
      a = toString style.opacity;
      surface = "alpha({{colors.surface.default.hex}}, ${a})";
      container = "alpha({{colors.surface_container.default.hex}}, ${a})";
    in ''
      /* Generated by Noctalia from the active theme; imported after noctalia.css. */
      @define-color window_bg_color ${surface};
      @define-color view_bg_color ${surface};
      @define-color headerbar_bg_color ${container};
      @define-color sidebar_bg_color ${container};
      @define-color secondary_sidebar_bg_color ${surface};
      @define-color dialog_bg_color ${surface};
      @define-color theme_bg_color ${surface};
      @define-color theme_base_color ${surface};
    ''
    + extra);
    gtkGlass = pkgs.writeText "gtk-glass.css.in" (gtkGlassCss "");

    # Thunar draws its own background on the notebook, views and sidebar on
    # top of the window's, and the translucent layers add up to nearly
    # opaque; its stylesheet clears them so only the window is glass.
    gtk3Glass = pkgs.writeText "gtk3-glass.css.in" (gtkGlassCss ("\n" + builtins.readFile ../templates/gtk3-thunar.css));
  in {
    xdg.configFile."noctalia/70-templates.toml".source =
      (pkgs.formats.toml {}).generate "70-templates.toml"
      {
        theme.templates.user = {
          terminal-colors = {
            input_path = "${../templates/terminal-colors.sh}";
            output_path = "$XDG_CACHE_HOME/noctalia/terminal-colors.sh";
            post_hook = "${pushTerminalColors}";
          };
          gtk3-glass = {
            input_path = "${gtk3Glass}";
            output_path = "$XDG_CONFIG_HOME/gtk-3.0/glass.css";
            post_hook = "${gtk3Changed}";
          };
          gtk4-glass = {
            input_path = "${gtkGlass}";
            output_path = "$XDG_CONFIG_HOME/gtk-4.0/glass.css";
            post_hook = "${glassLast}/bin/gtk-glass-last";
          };
          # fzf reads this file on every launch, so pickers recolour without a
          # shell reload (FZF_DEFAULT_OPTS_FILE, set in cli.nix).
          fzf = {
            input_path = "${../templates/fzf}";
            output_path = "$XDG_CONFIG_HOME/fzf/noctalia";
          };
          zathura = {
            # Backgrounds take the shared glass opacity; pages stay solid.
            input_path = pkgs.writeText "zathura.in" (builtins.replaceStrings ["@GLASS@"] [(toString style.opacity)] (builtins.readFile ../templates/zathura));
            output_path = "$XDG_CONFIG_HOME/zathura/noctalia";
            post_hook = "${reloadZathura}";
          };
        };
      };
  };
}
