;;; keys.el -*- lexical-binding: t -*-

;; The Space menu: SPC opens a menu of topics, and each shows its keys with
;; names. It holds Ly-sec's groups (f files, b buffers, p project, s search,
;; g git, o open, n notes, c code, h help, q quit) and Centaur Emacs's
;; hydras and key groups, ported to Meow:
;;   SPC t  toggles (Centaur's F6)      SPC w  windows (C-c w)
;;   SPC z  folds (kirigami, C-~)       SPC Z  hideshow
;;   SPC d  debugger (dape, M-F5)       SPC M  mode line (C-F6)
;;   SPC e  editing: rectangle, multiple cursors, iedit, expand, zap, links
;;   SPC A  AI (C-c a)   SPC D  dictionary (C-c d)   SPC T  TODOs (C-c t)
;;   SPC B  browse URL (C-c C-z)        SPC C  consult extras (C-c c)
;; Menus that stayed open as hydras stay open here too (funcs.el). Centaur's
;; own global keys (C-c ..., M-..., F-keys) work as well, in every Meow
;; state. SPC m is the major mode's C-c keys (SPC m c = C-c C-c), SPC x is
;; C-x, SPC 0-9 a numeric prefix; meow's editing keys are unchanged.

(require 'windmove)
(defvar my-leader-map (make-sparse-keymap "Commands"))

(dolist (group '(("f" . "files")
                 ("b" . "buffers")
                 ("p" . "project")
                 ("s" . "search")
                 ("g" . "git")
                 ("o" . "open")
                 ("n" . "notes")
                 ("c" . "code")
                 ("e" . "edit")
                 ("h" . "help")
                 ("q" . "quit")
                 ("A" . "AI")
                 ("D" . "dictionary")
                 ("T" . "TODOs")
                 ("B" . "browse")
                 ("C" . "consult")))
  (define-key my-leader-map (kbd (car group))
              (cons (capitalize (cdr group))
                    (make-sparse-keymap (capitalize (cdr group))))))

